generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth & Users ────────────────────────────────────────────────────────────

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  username             String    @unique
  password             String
  avatar               String?
  isActive             Boolean   @default(true)
  role                 Role      @default(PLAYER)
  twoFactorCode        String?
  twoFactorCodeExpiry  DateTime?
  twoFactorAttempts    Int       @default(0)
  twoFactorVerifiedAt  DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  player Player?

  @@map("users")
}

enum Role {
  ADMIN
  MODERATOR
  PLAYER
}

// ─── Players ─────────────────────────────────────────────────────────────────

model Player {
  id          String @id @default(cuid())
  userId      String @unique
  displayName String

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomsCreated      Room[]             @relation("RoomAdmin")
  tournamentPlayers TournamentPlayer[]
  matchPlayers      MatchPlayer[]
  votes             Vote[]
  answers           Answer[]
  wildcards         Wildcard[]
  scores            Score[]
  ranking           Ranking?

  @@map("players")
}

// ─── Questions & Categories ───────────────────────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  icon        String?
  color       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  questions Question[]
  votes     Vote[]
  matches   Match[]

  @@map("categories")
}

model Question {
  id         String     @id @default(cuid())
  text       String
  categoryId String
  difficulty Difficulty @default(MEDIUM)
  timeLimit  Int        @default(20)
  basePoints Int        @default(100)
  imageUrl   String?
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())

  category Category  @relation(fields: [categoryId], references: [id])
  options  Option[]
  answers  Answer[]

  @@index([categoryId, isActive])
  @@map("questions")
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model Option {
  id         String  @id @default(cuid())
  text       String
  isCorrect  Boolean @default(false)
  order      Int
  questionId String

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  Answer[]

  @@map("options")
}

// ─── Rooms ───────────────────────────────────────────────────────────────────

model Room {
  id               String     @id @default(cuid())
  code             String     @unique
  name             String
  maxPlayers       Int        @default(8)
  status           RoomStatus @default(WAITING)
  adminId          String
  adminIsSpectator Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  admin      Player     @relation("RoomAdmin", fields: [adminId], references: [id])
  tournament Tournament?

  @@map("rooms")
}

enum RoomStatus {
  WAITING
  FULL
  IN_PROGRESS
  FINISHED
}

// ─── Tournaments ─────────────────────────────────────────────────────────────

model Tournament {
  id         String           @id @default(cuid())
  roomId     String           @unique
  status     TournamentStatus @default(PENDING)
  winnerId   String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime         @default(now())

  room    Room               @relation(fields: [roomId], references: [id])
  rounds  Round[]
  players TournamentPlayer[]

  @@map("tournaments")
}

enum TournamentStatus {
  PENDING
  IN_PROGRESS
  FINISHED
}

model TournamentPlayer {
  id           String  @id @default(cuid())
  tournamentId String
  playerId     String
  seed         Int
  isReady      Boolean @default(false)
  isEliminated Boolean @default(false)
  position     Int?

  tournament Tournament @relation(fields: [tournamentId], references: [id])
  player     Player     @relation(fields: [playerId], references: [id])

  @@unique([tournamentId, playerId])
  @@index([tournamentId])
  @@map("tournament_players")
}

// ─── Rounds ──────────────────────────────────────────────────────────────────

model Round {
  id           String      @id @default(cuid())
  tournamentId String
  number       Int
  name         RoundName
  status       RoundStatus @default(PENDING)

  tournament Tournament @relation(fields: [tournamentId], references: [id])
  matches    Match[]

  @@unique([tournamentId, number])
  @@map("rounds")
}

enum RoundName {
  ROUND_OF_32
  ROUND_OF_16
  QUARTERFINALS
  SEMIFINALS
  FINAL
}

enum RoundStatus {
  PENDING
  IN_PROGRESS
  FINISHED
}

// ─── Matches ─────────────────────────────────────────────────────────────────

model Match {
  id         String      @id @default(cuid())
  roundId    String
  categoryId String?
  status     MatchStatus @default(PENDING)
  winnerId   String?
  isTiebreak Boolean     @default(false)
  startedAt  DateTime?
  finishedAt DateTime?

  round    Round        @relation(fields: [roundId], references: [id])
  category Category?    @relation(fields: [categoryId], references: [id])
  players  MatchPlayer[]
  votes    Vote[]
  answers  Answer[]
  wildcards Wildcard[]
  scores   Score[]
  history  MatchHistory?

  @@index([roundId, status])
  @@map("matches")
}

enum MatchStatus {
  PENDING
  VOTING
  IN_PROGRESS
  TIEBREAK
  FINISHED
}

model MatchPlayer {
  id       String @id @default(cuid())
  matchId  String
  playerId String
  bracket  Int

  match  Match  @relation(fields: [matchId], references: [id])
  player Player @relation(fields: [playerId], references: [id])

  @@unique([matchId, playerId])
  @@map("match_players")
}

// ─── Game Actions ─────────────────────────────────────────────────────────────

model Vote {
  id         String   @id @default(cuid())
  matchId    String
  playerId   String
  categoryId String
  createdAt  DateTime @default(now())

  match    Match    @relation(fields: [matchId], references: [id])
  player   Player   @relation(fields: [playerId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([matchId, playerId])
  @@map("votes")
}

model Answer {
  id           String   @id @default(cuid())
  matchId      String
  playerId     String
  questionId   String
  optionId     String?
  isCorrect    Boolean
  responseTime Float
  points       Int      @default(0)
  usedWildcard Boolean  @default(false)
  answeredAt   DateTime @default(now())

  match    Match    @relation(fields: [matchId], references: [id])
  player   Player   @relation(fields: [playerId], references: [id])
  question Question @relation(fields: [questionId], references: [id])
  option   Option?  @relation(fields: [optionId], references: [id])

  @@index([matchId, playerId])
  @@map("answers")
}

model Wildcard {
  id       String   @id @default(cuid())
  matchId  String
  playerId String
  usedAt   DateTime @default(now())

  match  Match  @relation(fields: [matchId], references: [id])
  player Player @relation(fields: [playerId], references: [id])

  @@unique([matchId, playerId])
  @@map("wildcards")
}

// ─── Scores & Ranking ────────────────────────────────────────────────────────

model Score {
  id             String @id @default(cuid())
  matchId        String
  playerId       String
  totalPoints    Int    @default(0)
  correctAnswers Int    @default(0)
  wrongAnswers   Int    @default(0)
  totalTime      Float  @default(0)

  match  Match  @relation(fields: [matchId], references: [id])
  player Player @relation(fields: [playerId], references: [id])

  @@unique([matchId, playerId])
  @@map("scores")
}

model Ranking {
  id             String   @id @default(cuid())
  playerId       String   @unique
  totalPoints    Int      @default(0)
  matchesPlayed  Int      @default(0)
  matchesWon     Int      @default(0)
  tournamentsWon Int      @default(0)
  winStreak      Int      @default(0)
  maxWinStreak   Int      @default(0)
  updatedAt      DateTime @updatedAt

  player Player @relation(fields: [playerId], references: [id])

  @@map("rankings")
}

model MatchHistory {
  id        String   @id @default(cuid())
  matchId   String   @unique
  summary   Json
  createdAt DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id])

  @@map("match_history")
}
